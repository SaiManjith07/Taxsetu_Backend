rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /businesses/{businessId}/invoices/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == businessId;
    }
    match /businesses/{businessId}/uploads/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == businessId;
    }
    match /businesses/{businessId}/voice/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == businessId;
    }
  }
}
