rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(businessId) {
      return isAuthenticated() && request.auth.uid == businessId;
    }
    // For read/update/delete: document must belong to the authenticated user
    function docBelongsToUser() {
      return isAuthenticated() && resource.data.business_id == request.auth.uid;
    }
    // For create: new document must have business_id = authenticated user
    function newDocBelongsToUser() {
      return isAuthenticated() && request.resource.data.business_id == request.auth.uid;
    }

    // User's own business profile (path = businesses/{uid})
    match /businesses/{businessId} {
      allow read, write: if isOwner(businessId);
    }

    // Invoices: generated by Watcher based on sale details; readable by business owner
    match /invoices/{invoiceId} {
      allow read: if docBelongsToUser();
      allow create: if newDocBelongsToUser();
      allow update, delete: if docBelongsToUser();
    }

    // Purchases: raw purchase entries captured by Watcher (voice/manual/CSV/image) and the app
    match /purchases/{purchaseId} {
      allow read: if docBelongsToUser();
      allow create: if newDocBelongsToUser();
      allow update, delete: if docBelongsToUser();
    }

    // Sale details: sale records linked to purchases; Watcher uses these to generate invoices
    match /sale_details/{saleId} {
      allow read: if docBelongsToUser();
      allow create: if newDocBelongsToUser();
      allow update, delete: if docBelongsToUser();
    }

    // Invoice templates: stored per business to generate printable/exportable invoices
    match /invoice_templates/{templateId} {
      allow read: if docBelongsToUser();
      allow create: if newDocBelongsToUser();
      allow update, delete: if docBelongsToUser();
    }

    // GSTIN credentials: extremely sensitive; only backend/admin (Watcher/Filer) with Admin SDK may access.
    // Block all direct client access; backend bypasses these rules.
    match /gstin_credentials/{credId} {
      allow read, write: if false;
    }

    // Filings: Filer (Cloud Function) creates; Guardian reads/list. Demo filings (business_id == 'demo') work without login so Try Demo shows filings in Guardian.
    match /filings/{filingId} {
      allow read: if (isAuthenticated() && (resource.data.business_id == request.auth.uid || resource.data.business_id == 'demo')) || resource.data.business_id == 'demo';
      allow create: if (isAuthenticated() && (request.resource.data.business_id == request.auth.uid || request.resource.data.business_id == 'demo')) || request.resource.data.business_id == 'demo';
      allow update, delete: if docBelongsToUser();
    }

    // Notices: Guardian creates/reads/updates
    match /notices/{noticeId} {
      allow read: if docBelongsToUser();
      allow create: if newDocBelongsToUser();
      allow update, delete: if docBelongsToUser();
    }

    // Notifications (e.g. Guardian alerts, supplier nudge). Demo can create/read for business_id == 'demo'.
    match /notifications/{notificationId} {
      allow read: if (isAuthenticated() && (resource.data.business_id == request.auth.uid || resource.data.business_id == 'demo')) || resource.data.business_id == 'demo';
      allow create: if (isAuthenticated() && (request.resource.data.business_id == request.auth.uid || request.resource.data.business_id == 'demo')) || request.resource.data.business_id == 'demo';
      allow update, delete: if docBelongsToUser() || resource.data.business_id == 'demo';
    }

    // Month totals (Calculator writes; dashboard/Guardian may read)
    match /month_totals/{docId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.business_id == request.auth.uid);
      allow create: if newDocBelongsToUser();
      allow update, delete: if docBelongsToUser();
    }

    // Return files (GSTR-1 / 2B / 3B JSON per month)
    match /return_files/{docId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.business_id == request.auth.uid);
      allow create: if newDocBelongsToUser();
      allow update, delete: if docBelongsToUser();
    }

    // Agent logs
    match /agent_logs/{logId} {
      allow read: if docBelongsToUser();
      allow create: if newDocBelongsToUser();
      allow update, delete: if docBelongsToUser();
    }

    // Ledger entries
    match /ledger_entries/{entryId} {
      allow read: if docBelongsToUser();
      allow create: if newDocBelongsToUser();
      allow update, delete: if docBelongsToUser();
    }

    // Master Planner: workflow executions (allow demo without auth, same as filings/notifications)
    match /workflow_executions/{execId} {
      allow read: if resource.data.business_id == 'demo' || (request.auth != null && resource.data.business_id == request.auth.uid);
      allow create: if request.resource.data.business_id == 'demo' || (request.auth != null && request.resource.data.business_id == request.auth.uid);
      allow update, delete: if resource.data.business_id == 'demo' || (request.auth != null && resource.data.business_id == request.auth.uid);
    }
    match /workflow_metrics/{metricId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }
    match /autonomous_decisions/{decisionId} {
      allow read: if docBelongsToUser();
      allow create: if newDocBelongsToUser();
      allow update, delete: if docBelongsToUser();
    }
  }
}
